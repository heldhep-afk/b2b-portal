# Локальная конфигурация с реальными доступами к базе — не публикуется.
config/db.php

# Счётчики лимитов (RateLimiter) создаются во время работы.
storage/ratelimit/*
!storage/ratelimit/.htaccess
storage/logs/
storage/cache/

